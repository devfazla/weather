# Telegram is the only backend: submissions, traffic counters and error
# reports all end up in a chat. Copy to .env.local for `npm run dev`, and add
# the same keys under Project → Settings → Environment Variables on Vercel.

# 1. @BotFather → /newbot → copy the token.
TELEGRAM_BOT_TOKEN=

# 2. Where contact messages and newsletter signups land. Send the bot a
#    message, then read the chat id from
#    https://api.telegram.org/bot<token>/getUpdates — or use @userinfobot.
#    For a channel, add the bot as an admin and use the @channelusername.
TELEGRAM_CHAT_ID=

# Optional. A channel or group for the traffic counters and client errors.
# The bot must be an admin there: the counters live in one pinned message
# that every visit rewrites. Defaults to TELEGRAM_CHAT_ID.
TELEGRAM_ANALYTICS_CHAT_ID=

# Optional. Salt for the hashed visitor IP shown in the messages.
ANALYTICS_SALT=

# Optional. Enables GET /api/stats — the counters and top countries as JSON.
# Without it the endpoint answers 501 instead of leaking traffic numbers.
STATS_TOKEN=
